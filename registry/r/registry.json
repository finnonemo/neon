{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "neon",
  "homepage": "https://github.com/finnonemo/neon",
  "items": [
    {
      "name": "neon-base",
      "type": "registry:base",
      "title": "Neon base",
      "description": "A Vite + React 19 app on shadcn/ui, Radix and Tailwind v4, themed with Finnomena's Neon roles.",
      "extends": "none",
      "config": {
        "style": "radix-nova",
        "tailwind": {
          "baseColor": "neutral",
          "cssVariables": true
        },
        "iconLibrary": "lucide",
        "registries": {
          "@neon": "https://raw.githubusercontent.com/finnonemo/neon/neon--v0.5.0/registry/r/{name}.json"
        }
      },
      "dependencies": [
        "@fontsource/ibm-plex-sans-thai@^5.3.0"
      ],
      "registryDependencies": [
        "https://raw.githubusercontent.com/finnonemo/neon/neon--v0.5.0/registry/r/theme.json",
        "https://raw.githubusercontent.com/finnonemo/neon/neon--v0.5.0/registry/r/utils.json",
        "https://raw.githubusercontent.com/finnonemo/neon/neon--v0.5.0/registry/r/button.json"
      ],
      "files": [
        {
          "path": "base/index.css",
          "type": "registry:file",
          "target": "src/index.css"
        },
        {
          "path": "base/main.tsx",
          "type": "registry:file",
          "target": "src/main.tsx"
        },
        {
          "path": "base/App.tsx",
          "type": "registry:file",
          "target": "src/App.tsx"
        },
        {
          "path": "base/app/AppRoot.tsx",
          "type": "registry:file",
          "target": "src/app/AppRoot.tsx"
        },
        {
          "path": "base/app/colorScheme.ts",
          "type": "registry:file",
          "target": "src/app/colorScheme.ts"
        },
        {
          "path": "../templates/vitejs-cds/index.html",
          "type": "registry:file",
          "target": "~/index.html"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:item",
      "title": "Neon theme",
      "description": "theme.css (the canonical CSS adapter) and the slot-to-role mapping that themes shadcn/ui with it.",
      "dependencies": [
        "tw-animate-css@^1.4.0"
      ],
      "files": [
        {
          "path": "../theme/css/theme.css",
          "type": "registry:file",
          "target": "src/theme/theme.css"
        },
        {
          "path": "theme/neon.css",
          "type": "registry:file",
          "target": "src/theme/neon.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn with Neon type roles",
      "dependencies": [
        "cn@^0.5.1"
      ],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib",
          "target": "src/lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "dependencies": [
        "radix-ui@^1.8.1",
        "class-variance-authority@^0.7.1"
      ],
      "registryDependencies": [
        "@neon/utils"
      ],
      "files": [
        {
          "path": "ui/button.tsx",
          "type": "registry:ui",
          "target": "src/components/ui/button.tsx"
        }
      ]
    }
  ]
}
