{
"component": "Snackbar",
"sets": [
{
  "name": "Snackbar",
  "axes": [
    {
      "name": "Leading",
      "values": [
        "Icon",
        "None",
        "Loading"
      ]
    },
    {
      "name": "Status",
      "values": [
        "Info",
        "Success",
        "Warning",
        "Error"
      ]
    },
    {
      "name": "Action",
      "values": [
        "None",
        "Button"
      ]
    }
  ],
  "exclude": [
    "{{Leading=None, Loading}}{{Status=Success, Warning, Error}}"
  ],
  "properties": [
    {
      "name": "Description text",
      "type": "TEXT",
      "default": "Message"
    }
  ],
  "variables": {
    "Snackbar/Container/None/Layout horizontal": "Fill container",
    "Snackbar/Container/None/Layout vertical": "Hug contents",
    "Snackbar/Container/None/Min height": 56,
    "Snackbar/Container/None/Gap horizontal": 8,
    "Snackbar/Container/None/Padding left": 16,
    "Snackbar/Container/None/Padding right": 16,
    "Snackbar/Container/None/Padding top": 0,
    "Snackbar/Container/None/Padding bottom": 0,
    "Snackbar/Container/None/Radius": 16,
    "Snackbar/Container/Button/Layout horizontal": "Fill container",
    "Snackbar/Container/Button/Layout vertical": "Hug contents",
    "Snackbar/Container/Button/Min height": 56,
    "Snackbar/Container/Button/Gap horizontal": 8,
    "Snackbar/Container/Button/Padding left": 16,
    "Snackbar/Container/Button/Padding right": 4,
    "Snackbar/Container/Button/Padding top": 0,
    "Snackbar/Container/Button/Padding bottom": 0,
    "Snackbar/Container/Button/Radius": 16,
    "Snackbar/Leading/Default/Padding top": 16,
    "Snackbar/Leading/Default/Padding bottom": 16,
    "Snackbar/Leading/Default/Padding right": 8,
    "Snackbar/Text/Default/Layout horizontal": "Fill container",
    "Snackbar/Text/Default/Padding top": 16,
    "Snackbar/Text/Default/Padding bottom": 16,
    "Snackbar/Text/Default/Gap vertical": 0,
    "Snackbar/Label/Description/Type token": "$callout",
    "Snackbar/Label/Description/Type emphasis": "Regular",
    "Snackbar/Label/Description/Align horizontal": "Left",
    "Snackbar/Label/Description/Align vertical": "Top",
    "Snackbar/Label/Description/Decoration": "-",
    "Snackbar/Icon/Medium/Type token": "fa-sharp fa-solid/Medium",
    "Snackbar/Icon/Medium/Layout width": 24,
    "Snackbar/Icon/Medium/Layout height": 24
  },
  "bindings": [
    {"layer":"(root)","property":"layoutMode","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"VERTICAL","literal":true},
    {"layer":"Container","property":"layoutMode","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HORIZONTAL","literal":true},
    {"layer":"Container","property":"layoutSizingHorizontal","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"FILL","literal":true},
    {"layer":"Container","property":"layoutSizingVertical","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HUG","literal":true},
    {"layer":"Container","property":"counterAxisAlignItems","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"CENTER","literal":true},
    {"layer":"Container","property":"minHeight","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Container/{{Action=*}}/Min height"},
    {"layer":"Container","property":"itemSpacing","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Container/{{Action=*}}/Gap horizontal"},
    {"layer":"Container","property":"paddingLeft","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Container/{{Action=*}}/Padding left"},
    {"layer":"Container","property":"paddingRight","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Container/{{Action=*}}/Padding right"},
    {"layer":"Container","property":"paddingTop","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Container/{{Action=*}}/Padding top"},
    {"layer":"Container","property":"paddingBottom","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Container/{{Action=*}}/Padding bottom"},
