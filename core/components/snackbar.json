    {"layer":"Container / Leading","property":"paddingTop","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Leading/Default/Padding top"},
    {"layer":"Container / Leading","property":"paddingBottom","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Leading/Default/Padding bottom"},
    {"layer":"Container / Leading","property":"paddingRight","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Leading/Default/Padding right"},
    {"layer":"Container / Leading / Icon box","property":"width","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Icon/Medium/Layout width"},
    {"layer":"Container / Leading / Icon box","property":"height","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Icon/Medium/Layout height"},
    {"layer":"Container / Leading / Icon box","property":"primaryAxisAlignItems","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"CENTER","literal":true},
    {"layer":"Container / Leading / Icon box","property":"counterAxisAlignItems","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"CENTER","literal":true},
    {"layer":"Container / Leading / Icon box / Icon","property":"visible","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true},
    {"layer":"Container / Leading / Icon box / Icon","property":"visible","when":"{{Leading=Icon}}{{Status=*}}{{Action=*}}","value":"true","literal":true},
    {"layer":"Container / Leading / Icon box / Icon","property":"textStyleId","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"fa-sharp fa-solid/Medium"},
    {"layer":"Container / Leading / Icon box / Icon","property":"characters","when":"{{Leading=*}}{{Status=Info}}{{Action=*}}","value":"circle-info","literal":true},
    {"layer":"Container / Leading / Icon box / Icon","property":"characters","when":"{{Leading=*}}{{Status=Success}}{{Action=*}}","value":"circle-check","literal":true},
    {"layer":"Container / Leading / Icon box / Icon","property":"characters","when":"{{Leading=*}}{{Status=Warning}}{{Action=*}}","value":"triangle-exclamation","literal":true},
    {"layer":"Container / Leading / Icon box / Icon","property":"characters","when":"{{Leading=*}}{{Status=Error}}{{Action=*}}","value":"circle-exclamation","literal":true},
