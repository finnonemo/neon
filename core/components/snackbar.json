    {"layer":"Container / Leading","property":"visible","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true},
    {"layer":"Container / Leading","property":"visible","when":"{{Leading=Icon, Loading}}{{Status=*}}{{Action=*}}","value":"true","literal":true},
    {"layer":"Container / Leading","property":"layoutMode","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"VERTICAL","literal":true},
    {"layer":"Container / Leading","property":"layoutSizingHorizontal","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HUG","literal":true},
    {"layer":"Container / Leading","property":"layoutSizingVertical","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"FILL","literal":true},
