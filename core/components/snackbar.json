    {"layer":"Container / Leading / Icon box / _Loading","property":"visible","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true},
    {"layer":"Container / Leading / Icon box / _Loading","property":"visible","when":"{{Leading=Loading}}{{Status=*}}{{Action=*}}","value":"true","literal":true},
    {"layer":"Container / Leading / Icon box / _Loading","property":"componentProperties.Size","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Medium"},
    {"layer":"Container / Text","property":"layoutMode","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"VERTICAL","literal":true},
    {"layer":"Container / Text","property":"layoutSizingHorizontal","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"FILL","literal":true},
    {"layer":"Container / Text","property":"layoutSizingVertical","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HUG","literal":true},
    {"layer":"Container / Text","property":"paddingTop","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Text/Default/Padding top"},
    {"layer":"Container / Text","property":"paddingBottom","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Text/Default/Padding bottom"},
    {"layer":"Container / Text","property":"itemSpacing","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Components/Snackbar/Text/Default/Gap vertical"},
    {"layer":"Container / Text / Description","property":"textStyleId","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Body/Callout"},
    {"layer":"Container / Text / Description","property":"layoutSizingHorizontal","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"FILL","literal":true},
    {"layer":"Container / Text / Description","property":"textAutoResize","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HEIGHT","literal":true},
    {"layer":"Container / Text / Description","property":"textAlignHorizontal","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"LEFT","literal":true},
    {"layer":"Container / Text / Description","property":"fills.0","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Theme/Text/text-inverse"},
    {"layer":"Container / Action","property":"visible","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true},
    {"layer":"Container / Action","property":"visible","when":"{{Leading=*}}{{Status=*}}{{Action=Button}}","value":"true","literal":true},
    {"layer":"Container / Action","property":"componentProperties.Hierarchy","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Tertiary"},
    {"layer":"Container / Action","property":"componentProperties.Type","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Inverse"},
    {"layer":"Container / Action","property":"componentProperties.Size","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Medium"},
    {"layer":"Container / Action","property":"componentProperties.State","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Enabled"},
    {"layer":"Container / Action","property":"layoutSizingHorizontal","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HUG","literal":true},
    {"layer":"Container / Action","property":"layoutSizingVertical","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HUG","literal":true},
    {"layer":"Container / Action","property":"componentProperties.Leading Icon","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true},
    {"layer":"Container / Action","property":"componentProperties.Trailing Icon","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true},
    {"layer":"Container / Action","property":"isExposedInstance","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"true","literal":true},
    {"layer":"Container / Close","property":"visible","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true},
    {"layer":"Container / Close","property":"visible","when":"{{Leading=*}}{{Status=*}}{{Action=Button}}","value":"true","literal":true},
    {"layer":"Container / Close","property":"componentProperties.Hierarchy","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Tertiary"},
    {"layer":"Container / Close","property":"componentProperties.Type","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Inverse"},
    {"layer":"Container / Close","property":"componentProperties.Size","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Medium"},
    {"layer":"Container / Close","property":"componentProperties.State","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"Enabled"},
    {"layer":"Container / Close","property":"layoutSizingHorizontal","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HUG","literal":true},
    {"layer":"Container / Close","property":"layoutSizingVertical","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"HUG","literal":true},
    {"layer":"Container / Close","property":"componentProperties.Icon Text","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"xmark"},
    {"layer":"Container / Close","property":"isExposedInstance","when":"{{Leading=*}}{{Status=*}}{{Action=*}}","value":"false","literal":true}
  ]
}
]
}
