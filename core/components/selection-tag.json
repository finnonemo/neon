    {"layer":"Container","property":"strokes.0","when":"{{State=Disabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/border-disabled"},
    {"layer":"Container / Leading Image","property":"componentProperties.Size","when":"{{Size=Large}}","value":"2XSmall","literal":true},
    {"layer":"Container / Leading Image","property":"componentProperties.Size","when":"{{Size=Medium, Small}}","value":"3XSmall","literal":true},
    {"layer":"Container / Leading Image","property":"componentProperties.Artwork","when":"{{Size=Large, Medium, Small}}","value":"Image","literal":true},
    {"layer":"Container / Leading Image","property":"componentProperties.Color","when":"{{Size=Large, Medium, Small}}","value":"Default","literal":true},
    {"layer":"Container / Leading Image","property":"isExposedInstance","when":"{{Size=Large, Medium, Small}}","value":"true","literal":true},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=Large}}","value":"fa-sharp fa-solid/Large"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=Medium}}","value":"fa-sharp fa-solid/Medium"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=Small}}","value":"fa-sharp fa-solid/Small"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=XSmall}}","value":"fa-sharp fa-solid/XSmall"},
    {"layer":"Container / Leading Icon","property":"fills.0","when":"{{State=Enabled, Hover}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color"},
    {"layer":"Container / Leading Icon","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color-disabled"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=Large}}","value":"Body/Body"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=Medium}}","value":"Body/Subheadline"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=Small}}","value":"Utility/Footnote"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=XSmall}}","value":"Utility/Caption 1"},
    {"layer":"Container / Label","property":"fills.0","when":"{{State=Enabled, Hover}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color"},
    {"layer":"Container / Label","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color-disabled"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=Large}}","value":"fa-sharp fa-solid/Large"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=Medium}}","value":"fa-sharp fa-solid/Medium"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=Small}}","value":"fa-sharp fa-solid/Small"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=XSmall}}","value":"fa-sharp fa-solid/XSmall"},
    {"layer":"Container / Trailing Icon","property":"fills.0","when":"{{State=Enabled, Hover}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color"},
    {"layer":"Container / Trailing Icon","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color-disabled"},
    {"layer":"Container / Remove","property":"textStyleId","when":"{{Size=Large}}","value":"fa-sharp fa-solid/Large"},
    {"layer":"Container / Remove","property":"textStyleId","when":"{{Size=Medium}}","value":"fa-sharp fa-solid/Medium"},
    {"layer":"Container / Remove","property":"textStyleId","when":"{{Size=Small}}","value":"fa-sharp fa-solid/Small"},
    {"layer":"Container / Remove","property":"textStyleId","when":"{{Size=XSmall}}","value":"fa-sharp fa-solid/XSmall"},
    {"layer":"Container / Remove","property":"fills.0","when":"{{State=Enabled, Hover}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color"},
    {"layer":"Container / Remove","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color-disabled"}
  ]
}
