    {"layer":"Container","property":"strokes.0","when":"{{State=Enabled, Hover}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/border"},
    {"layer":"Container","property":"strokes.0","when":"{{Hierarchy=Primary}}{{State=Enabled, Hover}}{{Selected=False}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/background-hover"},
    {"layer":"Container","property":"strokes.0","when":"{{Hierarchy=Secondary}}{{State=Enabled, Hover}}{{Selected=False}}","value":"Theme/Tag/{{Color=*}}/Tertiary/border"},
