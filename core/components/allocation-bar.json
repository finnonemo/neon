    },
    {
      "name": "Legend (Inline)",
      "type": "SLOT"
    }
  ],
  "variables": {
    "Allocation bar/Container/Medium/Gap vertical": 12,
    "Allocation bar/Bar/Medium/Layout height": 16,
    "Allocation bar/Bar/Medium/Gap horizontal": 2,
    "Allocation bar/Bar/Medium/Radius": 0,
    "Allocation bar/Item/Medium/Layout min-width": 4,
    "Allocation bar/Item/Medium/Padding left": 0,
    "Allocation bar/Item/Medium/Padding right": 0,
    "Allocation bar/Content/Medium/Gap horizontal": 16,
    "Allocation bar/Content/Medium/Gap vertical": 8,
    "Allocation bar/Container/Small/Gap vertical": 8,
    "Allocation bar/Bar/Small/Layout height": 8,
    "Allocation bar/Bar/Small/Gap horizontal": 2,
    "Allocation bar/Bar/Small/Radius": 0,
    "Allocation bar/Item/Small/Layout min-width": 4,
    "Allocation bar/Item/Small/Padding left": 0,
