    "Allocation bar/Label/Legend/Align horizontal": "Left",
    "Allocation bar/Label/Legend/Align vertical": "Top",
    "Allocation bar/Label/Legend/Decoration": "-",
    "Allocation bar/Icon/Small/Type token": "fa-sharp fa-solid/Small"
  },
  "bindings": [
    {"layer":"Container","property":"layoutSizingHorizontal","when":"{{Legend=*}}","value":"FILL","literal":true},
    {"layer":"Container","property":"layoutSizingVertical","when":"{{Legend=*}}","value":"HUG","literal":true},
    {"layer":"Container","property":"itemSpacing","when":"{{Size=*}}","value":"Components/Allocation bar/Container/{{Size=*}}/Gap vertical"},
    {"layer":"Container / Bar","property":"layoutSizingHorizontal","when":"{{Legend=*}}","value":"FILL","literal":true},
    {"layer":"Container / Bar","property":"layoutSizingVertical","when":"{{Legend=*}}","value":"FIXED","literal":true},
    {"layer":"Container / Bar","property":"height","when":"{{Size=*}}","value":"Components/Allocation bar/Bar/{{Size=*}}/Layout height"},
    {"layer":"Container / Bar","property":"cornerRadius","when":"{{Size=*}}","value":"Components/Allocation bar/Bar/{{Size=*}}/Radius"},
    {"layer":"Container / Bar","property":"fills.0","when":"{{Legend=*}}","value":"Theme/Chart/chart-empty"},
    {"layer":"Container / Bar","property":"fills.0","when":"{{State=Skeleton}}","value":"Theme/Skeleton/skeleton-background"},
    {"layer":"Container / Bar / Segments","property":"visible","when":"{{Legend=*}}","value":"false","literal":true},
    {"layer":"Container / Bar / Segments","property":"visible","when":"{{State=Data}}","value":"true","literal":true},
    {"layer":"Container / Bar / Segments","property":"layoutSizingHorizontal","when":"{{Legend=*}}","value":"FILL","literal":true},
    {"layer":"Container / Bar / Segments","property":"layoutSizingVertical","when":"{{Legend=*}}","value":"FILL","literal":true},
    {"layer":"Container / Bar / Segments","property":"itemSpacing","when":"{{Size=*}}","value":"Components/Allocation bar/Bar/{{Size=*}}/Gap horizontal"},
    {"layer":"Container / Legend (List)","property":"visible","when":"{{Legend=*}}","value":"false","literal":true},
    {"layer":"Container / Legend (List)","property":"visible","when":"{{Legend=List}}{{State=Data}}","value":"true","literal":true},
    {"layer":"Container / Legend (List)","property":"layoutSizingHorizontal","when":"{{Legend=*}}","value":"FILL","literal":true},
    {"layer":"Container / Legend (List)","property":"layoutSizingVertical","when":"{{Legend=*}}","value":"HUG","literal":true},
    {"layer":"Container / Legend (Inline)","property":"visible","when":"{{Legend=*}}","value":"false","literal":true},
    {"layer":"Container / Legend (Inline)","property":"visible","when":"{{Legend=Inline}}{{State=Data}}","value":"true","literal":true},
    {"layer":"Container / Legend (Inline)","property":"layoutSizingHorizontal","when":"{{Legend=*}}","value":"FILL","literal":true},
    {"layer":"Container / Legend (Inline)","property":"layoutSizingVertical","when":"{{Legend=*}}","value":"HUG","literal":true},
    {"layer":"Container / Legend (Inline)","property":"itemSpacing","when":"{{Size=*}}","value":"Components/Allocation bar/Content/{{Size=*}}/Gap horizontal"}
  ]
