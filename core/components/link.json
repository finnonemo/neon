    {"layer":"Container / Trailing Icon","property":"fills.0","when":"{{Style=Highlight}}{{State=Hover}}{{Size=*}}","value":"Theme/Link/link-primary-hover"},
    {"layer":"Container / Trailing Icon","property":"fills.0","when":"{{Style=Primary}}{{State=Enabled, Hover, Focus}}{{Size=*}}","value":"Theme/Text/text-primary"},
    {"layer":"Container / Trailing Icon","property":"fills.0","when":"{{Style=Primary}}{{State=Active}}{{Size=*}}","value":"Theme/Text/text-primary"},
