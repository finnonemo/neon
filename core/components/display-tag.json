{
"component": "Display tag",
"sets": [
{
  "name": "Display tag",
  "axes": [
    {
      "name": "Color",
      "values": [
        "White",
        "Yellow",
        "Navy",
        "Light Grey",
        "Green",
        "Blue",
        "Purple",
        "Red",
        "Orange",
        "Indigo"
      ]
    },
    {
      "name": "Hierarchy",
      "values": [
        "Primary",
        "Secondary",
        "Tertiary"
      ]
    },
    {
      "name": "State",
      "values": [
        "Enabled",
        "Disabled"
      ]
    },
    {
      "name": "Size",
      "values": [
        "Large",
        "Medium",
        "Small",
        "XSmall"
      ]
    }
  ],
  "exclude": [],
  "properties": [
    {
      "name": "Leading Icon",
      "type": "BOOLEAN",
      "default": true
    },
    {
      "name": "Trailing Icon",
      "type": "BOOLEAN",
      "default": true
    }
  ],
  "variables": {
    "Display tag/Container/Large/Layout horizontal": "Hug contents",
    "Display tag/Container/Large/Layout vertical": "Hug contents",
    "Display tag/Container/Large/Layout min-height": 40,
    "Display tag/Container/Large/Gap horizontal": 12,
    "Display tag/Container/Large/Padding left": 8,
    "Display tag/Container/Large/Padding right": 8,
    "Display tag/Container/Large/Padding top": 8,
    "Display tag/Container/Large/Padding bottom": 8,
    "Display tag/Container/Large/Radius": 8,
    "Display tag/Container/Large/Stroke weight": 1,
    "Display tag/Container/Medium/Layout horizontal": "Hug contents",
    "Display tag/Container/Medium/Layout vertical": "Hug contents",
    "Display tag/Container/Medium/Layout min-height": 32,
    "Display tag/Container/Medium/Gap horizontal": 8,
    "Display tag/Container/Medium/Padding left": 8,
    "Display tag/Container/Medium/Padding right": 8,
    "Display tag/Container/Medium/Padding top": 4,
    "Display tag/Container/Medium/Padding bottom": 4,
    "Display tag/Container/Medium/Radius": 8,
    "Display tag/Container/Medium/Stroke weight": 1,
    "Display tag/Container/Small/Layout horizontal": "Hug contents",
    "Display tag/Container/Small/Layout vertical": "Hug contents",
    "Display tag/Container/Small/Layout min-height": 24,
    "Display tag/Container/Small/Gap horizontal": 4,
    "Display tag/Container/Small/Padding left": 6,
    "Display tag/Container/Small/Padding right": 6,
    "Display tag/Container/Small/Padding top": 2,
    "Display tag/Container/Small/Padding bottom": 2,
    "Display tag/Container/Small/Radius": 4,
    "Display tag/Container/Small/Stroke weight": 1,
    "Display tag/Container/XSmall/Layout horizontal": "Hug contents",
    "Display tag/Container/XSmall/Layout vertical": "Hug contents",
    "Display tag/Container/XSmall/Layout min-height": 20,
    "Display tag/Container/XSmall/Gap horizontal": 4,
    "Display tag/Container/XSmall/Padding left": 4,
    "Display tag/Container/XSmall/Padding right": 4,
    "Display tag/Container/XSmall/Padding top": 1,
    "Display tag/Container/XSmall/Padding bottom": 1,
    "Display tag/Container/XSmall/Radius": 4,
    "Display tag/Container/XSmall/Stroke weight": 1,
    "Display tag/Icon/Large/Type token": "fa-sharp fa-solid/Large",
    "Display tag/Icon/Medium/Type token": "fa-sharp fa-solid/Medium",
    "Display tag/Icon/Small/Type token": "fa-sharp fa-solid/Small",
    "Display tag/Icon/XSmall/Type token": "fa-sharp fa-solid/XSmall",
    "Display tag/Label/Large/Type token": "$body",
    "Display tag/Label/Large/Type emphasis": "Regular",
    "Display tag/Label/Large/Align horizontal": "Center",
    "Display tag/Label/Large/Align vertical": "Center",
    "Display tag/Label/Large/Decoration": "-",
    "Display tag/Label/Medium/Type token": "$subhead",
    "Display tag/Label/Medium/Type emphasis": "Regular",
    "Display tag/Label/Medium/Align horizontal": "Center",
    "Display tag/Label/Medium/Align vertical": "Center",
    "Display tag/Label/Medium/Decoration": "-",
    "Display tag/Label/Small/Type token": "$footnote",
    "Display tag/Label/Small/Type emphasis": "Regular",
    "Display tag/Label/Small/Align horizontal": "Center",
    "Display tag/Label/Small/Align vertical": "Center",
    "Display tag/Label/Small/Decoration": "-",
    "Display tag/Label/XSmall/Type token": "$caption1",
    "Display tag/Label/XSmall/Type emphasis": "Regular",
    "Display tag/Label/XSmall/Align horizontal": "Center",
    "Display tag/Label/XSmall/Align vertical": "Center",
    "Display tag/Label/XSmall/Decoration": "-"
  },
  "bindings": [
    {"layer":"Container","property":"layoutSizingHorizontal","when":"{{Color=*}}","value":"HUG","literal":true},
    {"layer":"Container","property":"layoutSizingVertical","when":"{{Color=*}}","value":"HUG","literal":true},
    {"layer":"Container","property":"minHeight","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Layout min-height"},
    {"layer":"Container","property":"itemSpacing","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Gap horizontal"},
    {"layer":"Container","property":"paddingLeft","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Padding left"},
    {"layer":"Container","property":"paddingRight","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Padding right"},
    {"layer":"Container","property":"paddingTop","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Padding top"},
    {"layer":"Container","property":"paddingBottom","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Padding bottom"},
    {"layer":"Container","property":"cornerRadius","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Radius"},
    {"layer":"Container","property":"strokeWeight","when":"{{Size=*}}","value":"Components/Display tag/Container/{{Size=*}}/Stroke weight"},
    {"layer":"Container","property":"fills.0","when":"{{State=Enabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/background"},
    {"layer":"Container","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/background-disabled"},
    {"layer":"Container","property":"strokes.0","when":"{{Hierarchy=Tertiary}}{{State=Enabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/border"},
    {"layer":"Container","property":"strokes.0","when":"{{Hierarchy=Tertiary}}{{State=Disabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/border-disabled"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=Large}}","value":"fa-sharp fa-solid/Large"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=Medium}}","value":"fa-sharp fa-solid/Medium"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=Small}}","value":"fa-sharp fa-solid/Small"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Size=XSmall}}","value":"fa-sharp fa-solid/XSmall"},
    {"layer":"Container / Leading Icon","property":"fills.0","when":"{{State=Enabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color"},
    {"layer":"Container / Leading Icon","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Text/text-disabled"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=Large}}","value":"Body/Body"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=Medium}}","value":"Body/Subheadline"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=Small}}","value":"Utility/Footnote"},
    {"layer":"Container / Label","property":"textStyleId","when":"{{Size=XSmall}}","value":"Utility/Caption 1"},
    {"layer":"Container / Label","property":"fills.0","when":"{{State=Enabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color"},
    {"layer":"Container / Label","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Text/text-disabled"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=Large}}","value":"fa-sharp fa-solid/Large"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=Medium}}","value":"fa-sharp fa-solid/Medium"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=Small}}","value":"fa-sharp fa-solid/Small"},
    {"layer":"Container / Trailing Icon","property":"textStyleId","when":"{{Size=XSmall}}","value":"fa-sharp fa-solid/XSmall"},
    {"layer":"Container / Trailing Icon","property":"fills.0","when":"{{State=Enabled}}","value":"Theme/Tag/{{Color=*}}/{{Hierarchy=*}}/color"},
    {"layer":"Container / Trailing Icon","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Text/text-disabled"}
  ]
}
]
}
