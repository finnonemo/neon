{
"component": "Sliding button",
"sets": [
{
  "name": "Sliding button",
  "axes": [
    {
      "name": "State",
      "values": [
        "Enabled",
        "On drag",
        "Complete",
        "Loading",
        "Disabled"
      ]
    }
  ],
  "exclude": [],
  "properties": [
    {
      "name": "Label text",
      "type": "TEXT",
      "default": "Slide to confirm"
    }
  ],
  "variables": {
    "Sliding button/Container/Large/Layout min-height": 56,
    "Sliding button/Container/Large/Padding left": 0,
    "Sliding button/Container/Large/Padding right": 0,
    "Sliding button/Container/Large/Gap horizontal": 0,
    "Sliding button/Container/Large/Radius": 16,
    "Sliding button/Thumb/Large/Layout width": 56,
    "Sliding button/Thumb/Large/Radius": 16,
    "Sliding button/Label/Enabled/Padding left": 72,
    "Sliding button/Label/Enabled/Padding right": 72,
    "Sliding button/Label/Enabled/Padding top": 16,
    "Sliding button/Label/Enabled/Padding bottom": 16,
    "Sliding button/Label/Enabled/Type token": "$body",
    "Sliding button/Label/Enabled/Align horizontal": "Center",
    "Sliding button/Label/Enabled/Align vertical": "Top",
    "Sliding button/Label/Enabled/Decoration": "-",
    "Sliding button/Label/On drag/Padding left": 72,
    "Sliding button/Label/On drag/Padding right": 72,
    "Sliding button/Label/On drag/Padding top": 16,
    "Sliding button/Label/On drag/Padding bottom": 16,
    "Sliding button/Label/On drag/Type token": "$body",
    "Sliding button/Label/On drag/Align horizontal": "Center",
    "Sliding button/Label/On drag/Align vertical": "Top",
    "Sliding button/Label/On drag/Decoration": "-",
    "Sliding button/Label/Complete/Padding left": 72,
    "Sliding button/Label/Complete/Padding right": 72,
    "Sliding button/Label/Complete/Padding top": 16,
    "Sliding button/Label/Complete/Padding bottom": 16,
    "Sliding button/Label/Complete/Type token": "$body",
    "Sliding button/Label/Complete/Align horizontal": "Center",
    "Sliding button/Label/Complete/Align vertical": "Top",
    "Sliding button/Label/Complete/Decoration": "-",
    "Sliding button/Label/Loading/Padding left": 72,
    "Sliding button/Label/Loading/Padding right": 72,
    "Sliding button/Label/Loading/Padding top": 16,
    "Sliding button/Label/Loading/Padding bottom": 16,
    "Sliding button/Label/Loading/Type token": "$body",
    "Sliding button/Label/Loading/Align horizontal": "Center",
    "Sliding button/Label/Loading/Align vertical": "Top",
    "Sliding button/Label/Loading/Decoration": "-",
    "Sliding button/Label/Disabled/Padding left": 72,
    "Sliding button/Label/Disabled/Padding right": 72,
    "Sliding button/Label/Disabled/Padding top": 16,
    "Sliding button/Label/Disabled/Padding bottom": 16,
    "Sliding button/Label/Disabled/Type token": "$body",
    "Sliding button/Label/Disabled/Align horizontal": "Center",
    "Sliding button/Label/Disabled/Align vertical": "Top",
    "Sliding button/Label/Disabled/Decoration": "-",
    "Sliding button/Icon/Large/Type token": "fa-sharp fa-solid/Large"
  },
  "bindings": [
    {"layer":"(root)","property":"minWidth","when":"{{State=*}}","value":"Components/Interactive/Large/Interactive min-height"},
    {"layer":"(root)","property":"minHeight","when":"{{State=*}}","value":"Components/Interactive/Large/Interactive min-height"},
    {"layer":"Container","property":"minHeight","when":"{{State=*}}","value":"Components/Sliding button/Container/Large/Layout min-height"},
    {"layer":"Container","property":"itemSpacing","when":"{{State=*}}","value":"Components/Sliding button/Container/Large/Gap horizontal"},
    {"layer":"Container","property":"paddingLeft","when":"{{State=*}}","value":"Components/Sliding button/Container/Large/Padding left"},
    {"layer":"Container","property":"paddingRight","when":"{{State=*}}","value":"Components/Sliding button/Container/Large/Padding right"},
    {"layer":"Container","property":"cornerRadius","when":"{{State=*}}","value":"Components/Sliding button/Container/Large/Radius"},
    {"layer":"Container","property":"fills.0","when":"{{State=*}}","value":"Theme/Button/button-secondary"},
    {"layer":"Container / Indicator","property":"width","when":"{{State=Enabled, Disabled}}","value":"Components/Sliding button/Thumb/Large/Layout width"},
    {"layer":"Container / Indicator","property":"width","when":"{{State=On drag}}","value":0.4,"literal":true},
    {"layer":"Container / Indicator","property":"width","when":"{{State=Complete, Loading}}","value":1,"literal":true},
    {"layer":"Container / Indicator","property":"minWidth","when":"{{State=*}}","value":"Components/Sliding button/Thumb/Large/Layout width"},
    {"layer":"Container / Indicator","property":"cornerRadius","when":"{{State=*}}","value":"Components/Sliding button/Container/Large/Radius"},
    {"layer":"Container / Indicator","property":"fills.0","when":"{{State=*}}","value":"Theme/Button/button-primary"},
    {"layer":"Container / Indicator","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Button/button-disabled"},
    {"layer":"Container / Indicator / Handle","property":"visible","when":"{{State=*}}","value":"true","literal":true},
    {"layer":"Container / Indicator / Handle","property":"visible","when":"{{State=Loading}}","value":"false","literal":true},
    {"layer":"Container / Indicator / Handle","property":"width","when":"{{State=*}}","value":"Components/Sliding button/Thumb/Large/Layout width"},
    {"layer":"Container / Indicator / Handle","property":"cornerRadius","when":"{{State=*}}","value":"Components/Sliding button/Thumb/Large/Radius"},
    {"layer":"Container / Indicator / Handle / Arrow","property":"textStyleId","when":"{{State=*}}","value":"fa-sharp fa-solid/Large"},
    {"layer":"Container / Indicator / Handle / Arrow","property":"fills.0","when":"{{State=*}}","value":"Theme/Icon/icon-on-color"},
    {"layer":"Container / Indicator / Handle / Arrow","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Icon/icon-disabled"},
    {"layer":"Container / Label","property":"visible","when":"{{State=*}}","value":"true","literal":true},
    {"layer":"Container / Label","property":"opacity","when":"{{State=*}}","value":"1","literal":true},
    {"layer":"Container / Label","property":"opacity","when":"{{State=On drag, Loading}}","value":"0","literal":true},
    {"layer":"Container / Label","property":"paddingLeft","when":"{{State=*}}","value":"Components/Sliding button/Label/{{State=*}}/Padding left"},
    {"layer":"Container / Label","property":"paddingRight","when":"{{State=*}}","value":"Components/Sliding button/Label/{{State=*}}/Padding right"},
    {"layer":"Container / Label","property":"paddingTop","when":"{{State=*}}","value":"Components/Sliding button/Label/{{State=*}}/Padding top"},
    {"layer":"Container / Label","property":"paddingBottom","when":"{{State=*}}","value":"Components/Sliding button/Label/{{State=*}}/Padding bottom"},
    {"layer":"Container / Label / Text","property":"textStyleId","when":"{{State=*}}","value":"Body/Body"},
    {"layer":"Container / Label / Text","property":"fills.0","when":"{{State=*}}","value":"Theme/Text/text-primary"},
    {"layer":"Container / Label / Text","property":"fills.0","when":"{{State=Complete}}","value":"Theme/Text/text-on-color"},
    {"layer":"Container / Label / Text","property":"fills.0","when":"{{State=Disabled}}","value":"Theme/Text/text-disabled"},
    {"layer":"Container / _Loading","property":"visible","when":"{{State=*}}","value":"false","literal":true},
    {"layer":"Container / _Loading","property":"visible","when":"{{State=Loading}}","value":"true","literal":true},
    {"layer":"Container / _Loading","property":"componentProperties.Size","when":"{{State=Loading}}","value":"Medium"}
  ]
}
]
}
