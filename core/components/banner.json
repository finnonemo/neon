    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Artwork=Badge}}","value":"fa-sharp fa-solid/3XLarge"},
    {"layer":"Container / Leading Icon","property":"textStyleId","when":"{{Artwork=Icon}}","value":"fa-sharp fa-solid/Large"},
    {"layer":"Container / Leading Icon","property":"characters","when":"{{Status=Success}}","value":"circle-check","literal":true},
    {"layer":"Container / Leading Icon","property":"characters","when":"{{Status=Warning}}","value":"triangle-exclamation","literal":true},
    {"layer":"Container / Leading Icon","property":"characters","when":"{{Status=Error}}","value":"circle-exclamation","literal":true},
    {"layer":"Container / Leading Icon","property":"characters","when":"{{Status=Info}}","value":"circle-info","literal":true},
    {"layer":"Container / Leading Icon","property":"characters","when":"{{Status=Caution major}}","value":"circle-check","literal":true},
    {"layer":"Container / Leading Icon","property":"characters","when":"{{Status=Caution minor}}","value":"circle-check","literal":true},
    {"layer":"Container / Leading Icon","property":"fills.0","when":"{{Status=*}}","value":"Theme/Banner/{{Status=*}}/{{Hierarchy=*}}/icon"},
    {"layer":"Container / Title and Description / Title","property":"fills.0","when":"{{Status=*}}","value":"Theme/Banner/{{Status=*}}/{{Hierarchy=*}}/text"},
    {"layer":"Container / Title and Description / Description","property":"fills.0","when":"{{Status=*}}","value":"Theme/Banner/{{Status=*}}/{{Hierarchy=*}}/text"},
    {"layer":"Container / Icon button","property":"visible","when":"{{Status=*}}","value":"true","literal":true},
    {"layer":"Container / Icon button","property":"visible","when":"{{Action=None, Button, 2 Icon Buttons, Toggle}}","value":"false","literal":true},
    {"layer":"Container / Icon button","property":"componentProperties.Hierarchy","when":"{{Action=Icon Button}}","value":"Tertiary","literal":true},
    {"layer":"Container / Icon button","property":"componentProperties.Type","when":"{{Action=Icon Button}}","value":"Default","literal":true},
    {"layer":"Container / Button","property":"visible","when":"{{Status=*}}","value":"true","literal":true},
    {"layer":"Container / Button","property":"visible","when":"{{Action=None, Icon Button, 2 Icon Buttons, Toggle}}","value":"false","literal":true},
    {"layer":"Container / Button","property":"componentProperties.Hierarchy","when":"{{Action=Button}}","value":"Secondary","literal":true},
    {"layer":"Container / Button","property":"componentProperties.Type","when":"{{Action=Button}}","value":"Default","literal":true},
    {"layer":"Container / Action","property":"visible","when":"{{Status=*}}","value":"true","literal":true},
    {"layer":"Container / Action","property":"visible","when":"{{Action=None, Icon Button, Button, 2 Icon Buttons}}","value":"false","literal":true},
    {"layer":"Container / Action","property":"paddingTop","when":"{{Action=Toggle}}","value":"0","literal":true},
    {"layer":"Container / Action","property":"paddingBottom","when":"{{Action=Toggle}}","value":"0","literal":true},
    {"layer":"Container / Action","property":"itemSpacing","when":"{{Action=Toggle}}","value":"0","literal":true},
    {"layer":"Container / Icon Buttons","property":"visible","when":"{{Status=*}}","value":"true","literal":true},
    {"layer":"Container / Icon Buttons","property":"visible","when":"{{Action=None, Icon Button, Button, Toggle}}","value":"false","literal":true},
    {"layer":"Container / Icon Buttons / Icon button","property":"componentProperties.Hierarchy","when":"{{Action=2 Icon Buttons}}","value":"Secondary","literal":true},
    {"layer":"Container / Icon Buttons / Icon button","property":"componentProperties.Type","when":"{{Action=2 Icon Buttons}}","value":"Default","literal":true},
    {"layer":"Container / Action / Toggle","property":"visible","when":"{{Status=*}}","value":"false","literal":true},
    {"layer":"Container / Action / Toggle","property":"visible","when":"{{Action=Toggle}}","value":"true","literal":true},
    {"layer":"Container / Action / Toggle","property":"componentProperties.Style","when":"{{Action=Toggle}}","value":"Toggle only","literal":true}
